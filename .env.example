# Token Basic del MiR: base64("distributor:" + sha256_hex(password)).
# Cópialo de la web del MiR: Help → API → Authorize.
MIR_AUTH=Basic <token_base64>
# Override por robot si no comparten password (serial en mayúsculas, '-' → '_'):
# MIR_AUTH_MIR_2=Basic <otro_token>
# Override de IP por robot (opcional; por defecto se usa config/fleet.yaml):
# MIR_HOST_MIR_1=192.168.15.5

MQTT_HOST=localhost
MQTT_PORT=1883
