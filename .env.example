# Token Basic del MiR: base64("distributor:" + sha256_hex(password)).
# Cópialo de la web del MiR: Help → API → Authorize.
MIR_AUTH=Basic <token_base64>
# Override por robot si no comparten password (serial en mayúsculas, '-' → '_'):
# MIR_AUTH_MIR_2=Basic <otro_token>
# Override de IP por robot (opcional; por defecto, la de fleet.yaml):
# MIR_HOST_MIR_1=192.168.15.5

MQTT_HOST=localhost
MQTT_PORT=1883

# Datos de la instalación: fleet.yaml y catalog/ (decisión 135). Son de cada
# fábrica o centro y no van en este repo; guárdalos aparte (p. ej. en un repo
# privado al lado de este) y di aquí dónde. Rutas relativas a la raíz del FM.
# Sin estas líneas: config/fleet.yaml y catalog/ de este repo (fuera de git).
# FM_CONFIG=../mi-instalacion/fleet.yaml
# FM_CATALOG=../mi-instalacion/catalog
