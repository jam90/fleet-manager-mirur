# Token Basic del MiR: base64("distributor:" + sha256_hex(password)).
# Cópialo de la web del MiR: Help → API → Authorize.
MIR_AUTH=Basic <token_base64>
# Override por robot si no comparten password (serial en mayúsculas, '-' → '_'):
# MIR_AUTH_MIR_2=Basic <otro_token>
# Override de IP por robot (opcional; por defecto, la de fleet.yaml):
# MIR_HOST_MIR_1=192.168.15.5

# OMRON (driver omron, ARCL): clave del servidor ARCL del robot (MobilePlanner →
# Robot Interface → ARCL server setup). Por robot: OMRON_PASSWORD_OMRON_1=…
# OMRON_PASSWORD=<clave_arcl>
# Override de IP por robot (opcional; por defecto, la de fleet.yaml):
# OMRON_HOST_OMRON_1=192.168.1.50
# Telemetría por la API MQTT del robot (FLOW Core ≥ 4.1, puerto 8883, decisión 207).
# Usuario apiMonitor (solo lectura) o apiControl; se crean en SetNetGo. Sin clave,
# el estado se pregunta por ARCL como antes. Por robot: OMRON_MQTT_PASSWORD_OMRON_1=…
# OMRON_MQTT_USER=apiMonitor
# OMRON_MQTT_PASSWORD=<clave_mqtt>

MQTT_HOST=localhost
MQTT_PORT=1883

# Datos de la instalación: fleet.yaml y catalog/ (decisión 135). Son de cada
# fábrica o centro y no van en este repo; guárdalos aparte (p. ej. en un repo
# privado al lado de este) y di aquí dónde. Rutas relativas a la raíz del FM.
# Sin estas líneas: config/fleet.yaml y catalog/ de este repo (fuera de git).
# FM_CONFIG=../mi-instalacion/fleet.yaml
# FM_CATALOG=../mi-instalacion/catalog

# Datos que escribe el FM mientras funciona (decisión 160): la cola de
# fleet/order en SQLite, <FM_DATA>/<nombre del fleet.yaml>.sqlite. Sin esta
# línea: data/ de este repo (fuera de git).
# FM_DATA=../mi-instalacion-datos
