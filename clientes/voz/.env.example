# whisper.cpp server endpoints (server must be started with --convert)
WHISPER_URL=http://host.docker.internal:8080/inference
WHISPER_HEALTH_URL=http://host.docker.internal:8080/health
WHISPER_TIMEOUT=60
WHISPER_LANGUAGE=es
# Hint so whisper spells the wake word right
WHISPER_PROMPT=tonto

# Host port for the web app
APP_PORT=8000

# JSON table: mission name -> list of trigger words
MISSIONS_FILE=missions.json

# Fleet Manager REST API. The page chooses which one (default: simulated)
FM_URL=http://host.docker.internal:8050
FM_SIM_URL=http://host.docker.internal:8051

# Hands-free voice
WAKE_WORD=tonto
# Extra spellings accepted for the wake word (edit distance <= 1 is accepted anyway)
WAKE_VARIANTS=tonta,tanto,tono
CONFIRM_WORD=adelante
# Seconds to wait for the command after a bare wake word / for the confirm word
# (the countdown pauses while you speak and while whisper transcribes)
ARM_WINDOW_S=8
CONFIRM_WINDOW_S=10

# Voice log: every phrase, order sent and cancel in <dir>/voice.jsonl (empty = off).
# VOICE_LOG_AUDIO also keeps each phrase recording in <dir>/audio (they are voice recordings).
VOICE_LOG_DIR=logs
VOICE_LOG_AUDIO=true
