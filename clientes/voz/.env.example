# Endpoints del servidor whisper.cpp (debe arrancarse con --convert)
WHISPER_URL=http://host.docker.internal:8080/inference
WHISPER_HEALTH_URL=http://host.docker.internal:8080/health
WHISPER_TIMEOUT=60
WHISPER_LANGUAGE=es
# Pista para que whisper escriba bien la palabra de activación y el vocabulario de órdenes
# (palabras de missions.json + objetos/zonas). Medido en eval/bench_audio.py: 148 -> 164/197 aciertos,
# mismas acciones erróneas, +70 ms. Lista de palabras sueltas: con frases de ejemplo whisper las copia
# en la transcripción. "adelante" fuera a propósito (riesgo de confirmaciones falsas).
WHISPER_PROMPT=tonto, deja, dejar, dejalo, dejala, trae, traelo, traer, coge, coger, cogela, cogelo, para, parar, paralo, stop, caja, pieza, diferencial, rueda, motor, tornillo, estantería, mesa, almacén, zona de carga, banco de trabajo.

# Puerto del host para la web
APP_PORT=8000

# Tabla JSON: nombre de misión -> lista de palabras de disparo
MISSIONS_FILE=missions.json

# API REST del Fleet Manager. La página elige cuál (por defecto: la simulada)
FM_URL=http://host.docker.internal:8050
FM_SIM_URL=http://host.docker.internal:8051

# Voz manos libres
WAKE_WORD=tonto
# Grafías extra aceptadas para la palabra de activación (la distancia de edición <= 1 se acepta igualmente)
WAKE_VARIANTS=tonta,tanto,tono
CONFIRM_WORD=adelante
# Segundos de espera para la orden tras la palabra de activación sola / para la de confirmación
# (la cuenta atrás se pausa mientras hablas y mientras whisper transcribe)
ARM_WINDOW_S=8
CONFIRM_WINDOW_S=10

# Registro de voz: cada frase, order enviada y cancelación en <dir>/voice.jsonl (vacío = apagado).
# VOICE_LOG_AUDIO guarda además la grabación de cada frase en <dir>/audio (son grabaciones de voz).
VOICE_LOG_DIR=logs
VOICE_LOG_AUDIO=true
